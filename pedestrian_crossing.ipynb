from ultralytics import YOLO
from PIL import Image
from IPython.display import display
model = YOLO("yolov8n.pt")
image_path = "/kaggle/input/datasets/ujwalgh2123/image5"
results = model(image_path)
results[0].save("output.jpg")
display(Image.open("output.jpg"))
counts = {
    "car": 0,
    "motorcycle": 0,
    "bus": 0,
    "truck": 0,
    "bicycle": 0
}
for box in results[0].boxes:
    cls = int(box.cls[0])
    label = model.names[cls]
    if label in counts:
        counts[label] += 1
print("Vehicle Count:", counts)
pcu = (
    counts["motorcycle"] * 1 +
    counts["bicycle"] * 1 +
    counts["car"] * 2 +
    counts["bus"] * 5 +
    counts["truck"] * 5
)
print("Traffic Density (PCU):", pcu)
for person_box in results[0].boxes:
    cls = int(person_box.cls[0])
    label = model.names[cls]
    if label == "person":
        px1, py1, px2, py2 = person_box.xyxy[0].tolist()
        is_rider = False
        for vehicle_box in results[0].boxes:
            v_cls = int(vehicle_box.cls[0])
            v_label = model.names[v_cls]
            if v_label in ["motorcycle", "bicycle", "car"]:
                vx1, vy1, vx2, vy2 = vehicle_box.xyxy[0].tolist()
                if not (px2 < vx1 or px1 > vx2 or py2 < vy1 or py1 > vy2):
                    is_rider = True
                    break
        if not is_rider:
            pedestrian_count += 1
print("Actual Pedestrians:", pedestrian_count)
if pedestrian_count > 0:
    print("🚦 RED SIGNAL → Pedestrian Crossing")
else:
    if pcu > 50:
        green_time = 60
    elif pcu > 25:
        green_time = 40
    else:
        green_time = 20
    print("🚦 GREEN SIGNAL for", green_time, "seconds")
