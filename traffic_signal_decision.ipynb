from ultralytics import YOLO

# -------- LOAD MODEL --------
model = YOLO("yolov8n.pt")

# -------- ROAD IMAGES --------
roads = {"Road 1": "/kaggle/input/datasets/ujwalgh2123/image6",
    "Road 2": "/kaggle/input/datasets/ujwalgh2123/image2",
    "Road 3": "/kaggle/input/datasets/ujwalgh2123/image3",
    "Road 4": "/kaggle/input/datasets/ujwalgh2123/image4"
    
}

# -------- PROCESS EACH ROAD --------
def process_road(image_path):

    results = model(image_path)

    # ==============================
    # 🚗 VEHICLE COUNT
    # ==============================
    counts = {"car":0, "motorcycle":0, "bus":0, "truck":0, "bicycle":0}

    for box in results[0].boxes:
        label = model.names[int(box.cls[0])]
        if label in counts:
            counts[label] += 1

    # -------- PCU CALCULATION --------
    pcu = (
        counts["motorcycle"] * 1 +
        counts["bicycle"] * 1 +
        counts["car"] * 2 +
        counts["bus"] * 5 +
        counts["truck"] * 5
    )

    # ==============================
    # 🚶 PEDESTRIAN DETECTION (FINAL FIX)
    # ==============================
    pedestrian_count = 0
    image_height = results[0].orig_shape[0]

    for person_box in results[0].boxes:
        label = model.names[int(person_box.cls[0])]

        if label == "person":
            px1, py1, px2, py2 = person_box.xyxy[0].tolist()

            is_rider = False

            for vehicle_box in results[0].boxes:
                v_label = model.names[int(vehicle_box.cls[0])]

                if v_label in ["motorcycle", "bicycle", "car"]:
                    vx1, vy1, vx2, vy2 = vehicle_box.xyxy[0].tolist()

                    # ✔ Horizontal overlap
                    horizontal_overlap = not (px2 < vx1 or px1 > vx2)

                    # ✔ Vertical overlap
                    vertical_overlap = not (py2 < vy1 or py1 > vy2)

                    if horizontal_overlap and vertical_overlap:
                        is_rider = True
                        break

            # ✔ Check if person is near road (bottom area)
            person_bottom = py2
            is_on_road = person_bottom > (0.6 * image_height)

            # ✔ Final decision
            if not is_rider and is_on_road:
                pedestrian_count += 1

    return pcu, pedestrian_count, counts


# ==============================
# 🚦 PROCESS ALL ROADS
# ==============================

traffic_data = {}

for road, path in roads.items():
    pcu, pedestrians, counts = process_road(path)

    traffic_data[road] = {
        "pcu": pcu,
        "pedestrians": pedestrians,
        "counts": counts
    }

    print(f"\n{road}")
    print("Vehicles:", counts)
    print("PCU:", pcu)
    print("Pedestrians:", pedestrians)


# ==============================
# 🚦 FINAL DECISION (SAFE SYSTEM)
# ==============================

safe_roads = {}
blocked_roads = []

for road, data in traffic_data.items():
    if data["pedestrians"] > 0:
        blocked_roads.append(road)
    else:
        safe_roads[road] = data["pcu"]

# RED signals (pedestrian roads)
for road in blocked_roads:
    print(f"🚦 RED SIGNAL at {road} (Pedestrian Crossing)")

# GREEN signal (only safe roads)
if len(safe_roads) > 0:
    best_road = max(safe_roads, key=safe_roads.get)
    best_pcu = safe_roads[best_road]

    if best_pcu > 50:
        green_time = 60
    elif best_pcu > 25:
        green_time = 40
    else:
        green_time = 20

    print(f"\n🚦 GREEN SIGNAL → {best_road} for {green_time} seconds")

else:
    print("\n🚦 ALL ROADS BLOCKED (Pedestrians everywhere)")
